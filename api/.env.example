PRIVY_APP_ID=your-privy-app-id
# Use the same canonical MongoDB in development and production.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=eztudy
# The only Privy subject permitted to create this 0.1 installation's account.
EZTUDY_ALLOWED_SUBJECT=did:privy:your-owner-subject
# Comma-separated browser origins, for example https://study.example.com.
EZTUDY_CORS_ORIGINS=http://localhost:5175
# Backend-private registry for manually provisioned Ez installations.
EZ_BINDINGS_FILE=/absolute/private/ez-bindings.json
